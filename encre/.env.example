# =========================================================================
# EnTA — Teacher Model Configuration via Environment Variables
# =========================================================================
#
# Convention: ENTA_{MODEL_NAME}_{FIELD}
#   MODEL_NAME = any identifier, lowercase with hyphens
#   FIELD      = BACKEND_TYPE | API_KEY | BASE_URL | MODEL
#
# BACKEND_TYPE is the Encre backend: openai, anthropic, deepseek, glm, kimi,
#   minimax, alibaba, ollama, google, groq, etc.
#
# API_KEY is your API key for the provider.
# BASE_URL is the API endpoint (optional, most backends have defaults).
# MODEL is the model name sent in API calls (optional, most backends have defaults).
#
# The model name you use in EnTA is the lowercase, hyphenated version.
#   ENTA_DEEPSEEK_R1_API_KEY=...  →  EnTA calls it "deepseek-r1"
#   ENTA_MY_CUSTOM_MODEL_API_KEY=...  →  EnTA calls it "my-custom-model"
#
# =========================================================================
# EXAMPLE CONFIGURATIONS (uncomment and fill in your keys):
# =========================================================================

# ── DeepSeek R1 ───────────────────────────────────────────────────────
# ENTA_DEEPSEEK_R1_BACKEND_TYPE=deepseek
# ENTA_DEEPSEEK_R1_API_KEY=sk-your-key
# ENTA_DEEPSEEK_R1_MODEL=deepseek-reasoner

# ── DeepSeek V3.2 Chat ────────────────────────────────────────────────
# ENTA_DEEPSEEK_V3_2_BACKEND_TYPE=deepseek
# ENTA_DEEPSEEK_V3_2_API_KEY=sk-your-key
# ENTA_DEEPSEEK_V3_2_MODEL=deepseek-chat

# ── Qwen 3.6 (Alibaba) ────────────────────────────────────────────────
# ENTA_QWEN3_6_BACKEND_TYPE=alibaba
# ENTA_QWEN3_6_API_KEY=sk-your-key
# ENTA_QWEN3_6_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# ENTA_QWEN3_6_MODEL=qwen3-plus

# ── Agens 2.0 Flash ───────────────────────────────────────────────────
# ENTA_AGENS_2_0_FLASH_BACKEND_TYPE=openai
# ENTA_AGENS_2_0_FLASH_API_KEY=sk-your-key
# ENTA_AGENS_2_0_FLASH_BASE_URL=https://api.agens.com/v1
# ENTA_AGENS_2_0_FLASH_MODEL=agens-2.0-flash

# ── Agens 2.0 Video ───────────────────────────────────────────────────
# ENTA_AGENS_2_0_VIDEO_BACKEND_TYPE=openai
# ENTA_AGENS_2_0_VIDEO_API_KEY=sk-your-key
# ENTA_AGENS_2_0_VIDEO_BASE_URL=https://api.agens.com/v1
# ENTA_AGENS_2_0_VIDEO_MODEL=agens-2.0-video

# ── Claude Sonnet 4.6 (Anthropic) ─────────────────────────────────────
# ENTA_CLAUDE_SONNET_4_6_BACKEND_TYPE=anthropic
# ENTA_CLAUDE_SONNET_4_6_API_KEY=sk-ant-your-key
# ENTA_CLAUDE_SONNET_4_6_MODEL=claude-sonnet-4-20250514

# ── GLM 4.7 (Zhipu AI) ────────────────────────────────────────────────
# ENTA_GLM_4_7_BACKEND_TYPE=glm
# ENTA_GLM_4_7_API_KEY=your-key
# ENTA_GLM_4_7_MODEL=glm-4-plus

# ── MiniMax 2.5 ───────────────────────────────────────────────────────
# ENTA_MINIMAX_2_5_BACKEND_TYPE=minimax
# ENTA_MINIMAX_2_5_API_KEY=your-key
# ENTA_MINIMAX_2_5_MODEL=minimax-text-01

# ── Kimi K2 (Moonshot) ────────────────────────────────────────────────
# ENTA_KIMI_K2_BACKEND_TYPE=kimi
# ENTA_KIMI_K2_API_KEY=sk-your-key
# ENTA_KIMI_K2_MODEL=kimi-k2
